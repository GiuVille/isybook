---
import Base from '../layouts/Base.astro';
import EditionCard from '../components/EditionCard.astro';
import { getEditionsWithWork } from '../lib/data';

const editions = (await getEditionsWithWork()).filter((e) => e.edition_type !== 'standard');
---

<Base title="Edizioni speciali e limitate" description="Edizioni speciali, limitate e da collezione: bordi decorati, copertine alternative, box.">
  <h1>Edizioni speciali e limitate</h1>
  {editions.length ? <div class="grid">{editions.map((e) => <EditionCard edition={e} />)}</div> : <p class="muted">Nessuna edizione speciale al momento.</p>}
</Base>
