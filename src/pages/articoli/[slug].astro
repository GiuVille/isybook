---
import Base from '../../layouts/Base.astro';
import { getArticles } from '../../lib/data';
import { formatDate } from '../../lib/format';
import type { Article } from '../../lib/types';

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((article) => ({ params: { slug: article.slug }, props: { article } }));
}

const { article } = Astro.props as { article: Article };
const paragraphs = article.body.split(/\n{2,}/);
---

<Base title={article.title} description={article.excerpt ?? undefined}>
  <article class="post">
    {article.section && <a class="tag" href={`/rubriche/${article.section.slug}`}>{article.section.name}</a>}
    <h1>{article.title}</h1>
    {article.published_at && <p class="muted">{formatDate(article.published_at)}</p>}
    {paragraphs.map((p) => <p>{p}</p>)}
  </article>
</Base>

<style>
  .post { max-width: 68ch; }
  h1 { margin: 12px 0 4px; }
</style>
