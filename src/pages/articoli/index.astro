---
import Base from '../../layouts/Base.astro';
import { getArticles, getSections } from '../../lib/data';
import { formatDate } from '../../lib/format';

const [articles, sections] = await Promise.all([getArticles(), getSections()]);
---

<Base title="Articoli">
  <h1>Articoli</h1>
  <p class="tags">{sections.map((s) => <a class="tag" href={`/rubriche/${s.slug}`}>{s.name}</a>)}</p>
  <div class="list">
    {articles.map((a) => (
      <article class="card">
        <p class="muted meta">{a.section?.name}{a.published_at && ` · ${formatDate(a.published_at)}`}</p>
        <h2><a href={`/articoli/${a.slug}`}>{a.title}</a></h2>
        {a.excerpt && <p>{a.excerpt}</p>}
      </article>
    ))}
  </div>
</Base>

<style>
  .tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .list { display: grid; gap: 16px; }
  .meta { margin: 0; font-size: 0.85rem; }
  h2 { margin: 4px 0; font-size: 1.3rem; }
  h2 a { color: var(--text); text-decoration: none; }
</style>
