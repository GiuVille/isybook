---
// Pannello admin: pagina statica, tutta la logica gira nel browser (src/admin/app.ts).
import '@fontsource/gochi-hand';
import '@fontsource/young-serif';
import '@fontsource-variable/literata';
import '../../styles/global.css';
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Admin · IsyBooks</title>
  </head>
  <body>
    <div id="admin"><p class="loading">Caricamento…</p></div>
    <script>
      import '../../admin/app.ts';
    </script>
  </body>
</html>

<style is:global>
  .loading { padding: 32px; }
  .small { font-size: 0.85rem; }
  .error { color: #c0392b; }

  .layout { display: grid; grid-template-columns: 220px 1fr; min-height: 100vh; }
  aside { background: var(--surface); border-right: 1px solid var(--border); padding: 16px; display: flex; flex-direction: column; gap: 2px; }
  /* la colonna delle sezioni resta sempre a portata scorrendo la pagina, e se è più lunga dello schermo scorre da sola */
  aside { position: sticky; top: 0; align-self: start; height: 100vh; overflow-y: auto; overscroll-behavior: contain; }
  aside a { color: var(--text); text-decoration: none; padding: 4px 8px; border-radius: 6px; }
  aside a.active, aside a:hover { background: var(--accent-soft); color: var(--accent); }
  aside .brand { font-family: var(--font-display); font-weight: 700; font-size: 1.1rem; margin-bottom: 12px; }
  aside .brand small { color: var(--muted); font-weight: 400; font-family: var(--font-text); }
  aside .group { margin: 16px 0 4px; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); }
  .content { padding: 24px; min-width: 0; }
  .content h1 { margin-top: 0; }

  @media (max-width: 760px) {
    .layout { grid-template-columns: 1fr; }
    /* telefono: le sezioni stanno in cima, nel flusso della pagina */
    aside { position: static; height: auto; overflow: visible; flex-direction: row; flex-wrap: wrap; border-right: 0; border-bottom: 1px solid var(--border); }
    aside .group { width: 100%; margin: 8px 0 0; }
    .content { padding: 16px; }
  }

  .toolbar { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; justify-content: space-between; }
  .filters { display: flex; flex-wrap: wrap; gap: 8px; margin: 12px 0; }
  .crumbs { margin: 0 0 4px; font-size: 0.9rem; }

  input, select, textarea, button, .button {
    font: inherit; color: inherit; border-radius: 8px; border: 1px solid var(--border); background: var(--bg); padding: 8px 10px;
  }
  textarea { width: 100%; resize: vertical; }
  .mono { font-family: ui-monospace, Consolas, monospace; font-size: 0.85rem; }
  button, .button { background: var(--accent); color: #fff; border-color: var(--accent); cursor: pointer; text-decoration: none; display: inline-block; }
  .button.secondary { background: transparent; color: var(--accent); }
  button.danger { background: transparent; color: #c0392b; border-color: #c0392b; }
  button.link { background: none; border: 0; color: var(--accent); padding: 4px 8px; text-align: left; }

  .form { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 16px; margin-top: 16px; }
  .field { display: flex; flex-direction: column; gap: 4px; }
  .field input, .field select { width: 100%; }
  .field.wide, .actions.wide { grid-column: 1 / -1; }
  .field label, legend { font-weight: 600; font-size: 0.9rem; }
  .proposed { display: flex; flex-wrap: wrap; gap: 4px 14px; }
  .proposed .new-name { max-width: 200px; }
  .proposed small { font-weight: 600; }
  .image-field { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .image-field .image-preview { width: 120px; height: 90px; object-fit: cover; border-radius: 6px; border: 1px solid var(--border); }
  .image-field.is-uploading { opacity: 0.6; pointer-events: none; }
  /* menu a tendina con ricerca (src/admin/picker.ts): tropes, generi, autori, editore… */
  fieldset.m2m { border: 0; padding: 0; margin: 0; }
  .m2m-list[hidden], select[hidden] { display: none; }
  .picker { position: relative; display: flex; flex-direction: column; gap: 8px; max-width: 560px; }
  .picker-chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .picker-chips[hidden] { display: none; }
  .picker-chip { display: inline-flex; align-items: center; gap: 4px; padding: 4px 4px 4px 12px; font-size: 0.95rem; color: var(--accent); background: var(--accent-soft); border-radius: 999px; }
  .picker-chip button { display: grid; place-items: center; width: 26px; height: 26px; padding: 0; font-size: 0.8rem; color: inherit; background: none; border: 0; border-radius: 50%; cursor: pointer; }
  .picker-chip button:hover { background: rgba(0, 0, 0, 0.08); }
  .picker-box { position: relative; display: flex; }
  .picker-input { flex: 1; min-height: 44px; padding-right: 44px; font-size: 1rem; background: var(--surface); }
  .picker-input:focus { outline: 2px solid var(--accent); outline-offset: 1px; }
  .picker-toggle { position: absolute; right: 2px; top: 2px; bottom: 2px; width: 40px; padding: 0; font-size: 1rem; color: var(--muted); background: none; border: 0; cursor: pointer; }
  .picker-list { position: absolute; z-index: 30; top: 100%; left: 0; right: 0; max-height: 280px; margin: 4px 0 0; padding: 4px; overflow-y: auto; list-style: none; background: var(--surface); border: 1px solid var(--border); border-radius: 10px; box-shadow: 0 12px 28px rgba(0, 0, 0, 0.18); }
  .picker-list[hidden] { display: none; }
  .picker-list li { display: flex; align-items: center; gap: 8px; min-height: 40px; padding: 6px 10px; border-radius: 6px; cursor: pointer; }
  .picker-list li.is-active, .picker-list li:hover { background: var(--accent-soft); }
  .picker-list li[aria-selected="true"] { font-weight: 600; color: var(--accent); }
  .picker-check { width: 1em; flex: none; color: var(--accent); }
  .picker-create { color: var(--accent); font-weight: 600; }
  .picker-empty { color: var(--muted); cursor: default; }
  /* Da approvare: ricerca e filtri */
  .queue-search { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px; margin: 10px 0 4px; }
  .queue-search input[type='search'] { flex: 1 1 260px; min-height: 40px; }
  .queue-search label { display: inline-flex; align-items: center; gap: 6px; font-size: 0.9rem; color: var(--muted); }
  .queue-search select { min-height: 40px; color: var(--text); }
  .queue-item[hidden] { display: none; }
  .check { font-weight: 400 !important; display: flex; gap: 6px; align-items: center; }
  .actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }

  .stats { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 12px; margin-bottom: 16px; }
  .site-card { margin-top: 20px; max-width: 520px; }

  /* post social: comandi a sinistra, anteprime e testo a destra */
  .social { display: grid; grid-template-columns: minmax(260px, 340px) 1fr; gap: 20px; align-items: start; }
  .social-controls { display: flex; flex-direction: column; gap: 6px; position: sticky; top: 16px; }
  .social-controls select { margin-bottom: 8px; }
  .social-controls fieldset { border: 0; padding: 0; margin: 8px 0 0; }
  .social-controls legend { font-weight: 600; margin-bottom: 4px; }
  .formats { display: grid; grid-template-columns: 1fr 1fr; gap: 4px 12px; }
  .social-items { display: flex; flex-direction: column; gap: 6px; max-height: 50vh; overflow-y: auto; }
  .social-item { display: flex; gap: 8px; align-items: flex-start; font-weight: 400; }
  .social-slides { display: flex; gap: 16px; overflow-x: auto; padding-bottom: 8px; }
  .social-slides figure { margin: 0; flex: none; display: flex; flex-direction: column; gap: 8px; align-items: flex-start; }
  .social-slides canvas { width: 300px; height: auto; border-radius: 8px; box-shadow: 0 6px 18px rgba(0, 0, 0, 0.18); }
  .social-slides[data-format='story'] canvas { width: 240px; }
  .social-output textarea { width: 100%; font: inherit; }
  .standalone { max-width: 1200px; margin: 0 auto; padding: 24px; }
  @media (max-width: 800px) {
    .social { grid-template-columns: 1fr; }
    .social-controls { position: static; }
  }
  .site-card h2 { margin: 0 0 8px; font-size: 1.2rem; }
  .site-card p { margin: 0 0 8px; }
  .stat { text-decoration: none; color: var(--text); }
  .stat strong { display: block; font-size: 1.8rem; color: var(--accent); }

  .pill { display: inline-block; padding: 1px 8px; border-radius: 999px; font-size: 0.8rem; background: var(--accent-soft); color: var(--accent); }
  .pill.draft { background: var(--limited-soft); color: var(--limited); }
  .pill.archived { background: var(--border); color: var(--muted); }

  .children { margin-top: 32px; }
  .queue { display: grid; gap: 8px; }
  .queue-tools { display: grid; gap: 8px; margin-bottom: 14px; }
  .queue-filter { display: flex; flex-wrap: wrap; gap: 6px; }
  .queue-filter .pill { text-decoration: none; }
  .queue-filter .pill.is-on { outline: 2px solid currentColor; }
  .queue-bulk { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 16px; }
  /* elenco con copertina e pallino di stato (Opere, Edizioni) */
  /* bozza ripristinata (src/admin/draft.ts) */
  .draft-note { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 6px 12px; margin: 10px 0 0; padding: 10px 12px; font-size: 0.92rem; background: #fff8e8; border: 1px solid #e3c78a; border-radius: 8px; }
  /* suggerimenti (src/admin/suggest.ts) */
  .suggest { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin: 6px 0; padding: 8px 10px; font-size: 0.88rem; background: #fff8e8; border: 1px dashed #e3c78a; border-radius: 8px; }
  .suggest[hidden] { display: none; }
  .suggest-title { color: var(--muted); }
  .suggest-chip, .suggest-all { padding: 4px 10px; font-size: 0.88rem; color: var(--accent); background: var(--surface); border: 1px solid var(--accent-soft); border-radius: 999px; cursor: pointer; }
  .suggest-chip:hover, .suggest-all:hover { border-color: var(--accent); }
  .suggest-all { font-weight: 600; }
  .form-head { display: flex; align-items: center; gap: 14px; }
  .form-head h1 { margin: 0; }
  .form-cover { width: 64px; height: 92px; flex: none; object-fit: cover; border-radius: 3px; box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2); }
  .list-title { display: inline-flex; align-items: center; gap: 10px; }
  .dot { width: 12px; height: 12px; flex: none; border-radius: 50%; box-shadow: 0 0 0 2px var(--surface), 0 0 0 3px rgba(0, 0, 0, 0.12); }
  .dot.green { background: #2e9d5b; }
  .dot.orange { background: #e8902b; }
  .dot.red { background: #d64545; }
  .dot-legend { display: flex; flex-wrap: wrap; gap: 6px 16px; margin: 4px 0 10px; font-size: 0.85rem; color: var(--muted); }
  .dot-legend span { display: inline-flex; align-items: center; gap: 6px; }
  .queue-thumb { width: 32px; height: 46px; flex: none; object-fit: cover; border-radius: 2px; background: var(--border); }
  .bulk-space { width: 13px; }
  .adapt-head { display: flex; gap: 16px; align-items: flex-start; }
  .adapt-poster { width: 110px; border-radius: 4px; }
  .queue-item { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; text-decoration: none; color: var(--text); }
  .summary { display: grid; grid-template-columns: max-content 1fr; gap: 4px 16px; margin: 0 0 16px; }
  .summary dt { color: var(--muted); }
  .summary dd { margin: 0; }
  pre { overflow-x: auto; font-size: 0.8rem; background: var(--bg); padding: 12px; border-radius: 8px; }
  details { margin: 12px 0; }

  .login { max-width: 360px; margin: 10vh auto; display: flex; flex-direction: column; gap: 12px; }
  .login label { display: flex; flex-direction: column; gap: 4px; }

  .flash { position: fixed; bottom: 16px; right: 16px; padding: 10px 16px; border-radius: 8px; background: #2e7d4f; color: #fff; z-index: 10; max-width: calc(100vw - 32px); }
  .flash.error { background: #c0392b; }
</style>
