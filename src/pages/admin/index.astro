---
// Pannello admin: pagina statica, tutta la logica gira nel browser (src/admin/app.ts).
import '@fontsource/gochi-hand';
import '@fontsource/young-serif';
import '@fontsource-variable/literata';
import '../../styles/global.css';
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Admin · IsyBooks</title>
  </head>
  <body>
    <div id="admin"><p class="loading">Caricamento…</p></div>
    <script>
      import '../../admin/app.ts';
    </script>
  </body>
</html>

<style is:global>
  .loading { padding: 32px; }
  .small { font-size: 0.85rem; }
  .error { color: #c0392b; }

  .layout { display: grid; grid-template-columns: 220px 1fr; min-height: 100vh; }
  aside { background: var(--surface); border-right: 1px solid var(--border); padding: 16px; display: flex; flex-direction: column; gap: 2px; }
  /* la colonna delle sezioni resta sempre a portata scorrendo la pagina, e se è più lunga dello schermo scorre da sola */
  aside { position: sticky; top: 0; align-self: start; height: 100vh; overflow-y: auto; overscroll-behavior: contain; }
  aside a { color: var(--text); text-decoration: none; padding: 4px 8px; border-radius: 6px; }
  aside a.active, aside a:hover { background: var(--accent-soft); color: var(--accent); }
  aside .brand { font-family: var(--font-display); font-weight: 700; font-size: 1.1rem; margin-bottom: 12px; }
  aside .brand small { color: var(--muted); font-weight: 400; font-family: var(--font-text); }
  aside .group { margin: 16px 0 4px; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); }
  .content { padding: 24px; min-width: 0; }
  .content h1 { margin-top: 0; }

  @media (max-width: 760px) {
    .layout { grid-template-columns: 1fr; }
    /* telefono: le sezioni stanno in cima, nel flusso della pagina */
    aside { position: static; height: auto; overflow: visible; flex-direction: row; flex-wrap: wrap; border-right: 0; border-bottom: 1px solid var(--border); }
    aside .group { width: 100%; margin: 8px 0 0; }
    .content { padding: 16px; }
  }

  .toolbar { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; justify-content: space-between; }
  .filters { display: flex; flex-wrap: wrap; gap: 8px; margin: 12px 0; }
  .crumbs { margin: 0 0 4px; font-size: 0.9rem; }

  input, select, textarea, button, .button {
    font: inherit; color: inherit; border-radius: 8px; border: 1px solid var(--border); background: var(--bg); padding: 8px 10px;
  }
  textarea { width: 100%; resize: vertical; }
  .mono { font-family: ui-monospace, Consolas, monospace; font-size: 0.85rem; }
  button, .button { background: var(--accent); color: #fff; border-color: var(--accent); cursor: pointer; text-decoration: none; display: inline-block; }
  .button.secondary { background: transparent; color: var(--accent); }
  button.danger { background: transparent; color: #c0392b; border-color: #c0392b; }
  button.link { background: none; border: 0; color: var(--accent); padding: 4px 8px; text-align: left; }

  .form { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 16px; margin-top: 16px; }
  .field { display: flex; flex-direction: column; gap: 4px; }
  .field input, .field select { width: 100%; }
  .field.wide, .actions.wide { grid-column: 1 / -1; }
  .field label, legend { font-weight: 600; font-size: 0.9rem; }
  .proposed { display: flex; flex-wrap: wrap; gap: 4px 14px; }
  .proposed .new-name { max-width: 200px; }
  .proposed small { font-weight: 600; }
  .image-field { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .image-field .image-preview { width: 120px; height: 90px; object-fit: cover; border-radius: 6px; border: 1px solid var(--border); }
  .image-field.is-uploading { opacity: 0.6; pointer-events: none; }
  /* menu a tendina con ricerca (src/admin/picker.ts): tropes, generi, autori, editore… */
  fieldset.m2m { border: 0; padding: 0; margin: 0; }
  .m2m-list[hidden], select[hidden] { display: none; }
  .picker { position: relative; display: flex; flex-direction: column; gap: 8px; max-width: 560px; }
  .picker-chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .picker-chips[hidden] { display: none; }
  .picker-chip { display: inline-flex; align-items: center; gap: 4px; padding: 4px 4px 4px 12px; font-size: 0.95rem; color: var(--accent); background: var(--accent-soft); border-radius: 999px; }
  .picker-chip button { display: grid; place-items: center; width: 26px; height: 26px; padding: 0; font-size: 0.8rem; color: inherit; background: none; border: 0; border-radius: 50%; cursor: pointer; }
  .picker-chip button:hover { background: rgba(0, 0, 0, 0.08); }
  .picker-box { position: relative; display: flex; }
  .picker-input { flex: 1; min-height: 44px; padding-right: 44px; font-size: 1rem; background: var(--surface); }
  .picker-input:focus { outline: 2px solid var(--accent); outline-offset: 1px; }
  .picker-toggle { position: absolute; right: 2px; top: 2px; bottom: 2px; width: 40px; padding: 0; font-size: 1rem; color: var(--muted); background: none; border: 0; cursor: pointer; }
  .picker-list { position: absolute; z-index: 30; top: 100%; left: 0; right: 0; max-height: 280px; margin: 4px 0 0; padding: 4px; overflow-y: auto; list-style: none; background: var(--surface); border: 1px solid var(--border); border-radius: 10px; box-shadow: 0 12px 28px rgba(0, 0, 0, 0.18); }
  .picker-list[hidden] { display: none; }
  .picker-list li { display: flex; align-items: center; gap: 8px; min-height: 40px; padding: 6px 10px; border-radius: 6px; cursor: pointer; }
  .picker-list li.is-active, .picker-list li:hover { background: var(--accent-soft); }
  .picker-list li[aria-selected="true"] { font-weight: 600; color: var(--accent); }
  .picker-check { width: 1em; flex: none; color: var(--accent); }
  .picker-create { color: var(--accent); font-weight: 600; }
  .picker-empty { color: var(--muted); cursor: default; }
  /* telefono: il campo apre un foglio a tutto schermo (picker.ts, sheet); la tastiera sale solo toccando «Cerca…» */
  .picker-input.is-trigger { cursor: pointer; caret-color: transparent; }
  .picker-sheet { position: fixed; top: var(--vvt, 0px); left: 0; width: 100%; max-width: none; height: var(--vvh, 100dvh); max-height: none; margin: 0; padding: 12px 14px 0; color: var(--text); background: var(--surface); border: 0; border-radius: 0; }
  .picker-sheet[open] { display: flex; flex-direction: column; gap: 10px; }
  .picker-sheet::backdrop { background: rgba(0, 0, 0, 0.35); }
  .picker-sheet-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .picker-sheet-head strong { font-size: 1.1rem; }
  .picker-done { min-width: 96px; min-height: 44px; font-weight: 700; border-radius: 999px; }
  .picker-sheet .picker-input { flex: none; width: 100%; padding-right: 10px; font-size: 16px; }
  .picker-sheet .picker-list { position: static; flex: 1; min-height: 0; max-height: none; margin: 0 -14px; padding: 4px 8px 16px; border: 0; border-top: 1px solid var(--border); border-radius: 0; box-shadow: none; overscroll-behavior: contain; }
  .picker-sheet .picker-list li { min-height: 48px; font-size: 1rem; }
  @media (prefers-reduced-motion: no-preference) {
    .picker-sheet[open] { animation: picker-sheet-in 0.2s ease-out; }
    @keyframes picker-sheet-in { from { opacity: 0; transform: translateY(24px); } }
  }
  /* Da approvare: sezioni a cartellina */
  .queue-tabs { display: flex; flex-wrap: wrap; gap: 6px; margin: 4px 0 10px; border-bottom: 2px solid var(--border); }
  .queue-tab { display: inline-flex; align-items: center; gap: 8px; margin-bottom: -2px; padding: 10px 16px; font-weight: 600; color: var(--muted); text-decoration: none; background: var(--bg); border: 2px solid var(--border); border-radius: 10px 10px 0 0; }
  .queue-tab:hover { color: var(--accent); }
  .queue-tab.is-on { color: var(--accent); background: var(--surface); border-bottom-color: var(--surface); }
  .queue-tab-n { min-width: 1.6em; padding: 1px 7px; font-size: 0.8rem; text-align: center; color: var(--surface); background: var(--accent); border-radius: 999px; }
  .queue-tab:not(.is-on) .queue-tab-n { background: var(--muted); }
  .pill.expired { background: #fde3e3; color: #b3261e; }
  /* Da approvare: ricerca e filtri */
  .queue-search { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px; margin: 10px 0 4px; }
  .queue-search input[type='search'] { flex: 1 1 260px; min-height: 40px; }
  .queue-search label { display: inline-flex; align-items: center; gap: 6px; font-size: 0.9rem; color: var(--muted); }
  .queue-search select { min-height: 40px; color: var(--text); }
  .queue-item[hidden] { display: none; }
  .check { font-weight: 400 !important; display: flex; gap: 6px; align-items: center; }
  .actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }

  /* modulo di modifica (src/admin/app.ts formSections, src/admin/form-help.ts) */
  .form-layout { margin-top: 16px; }
  .form-layout.with-preview { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 20px; align-items: start; }
  .form-layout.with-preview .form-preview { order: 2; position: sticky; top: 16px; }
  .form-sections { display: flex; flex-direction: column; gap: 14px; min-width: 0; }
  .form-group, .form-more { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 16px; }
  .form-group h2 { margin: 0 0 12px; font-size: 1.05rem; }
  .form-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 14px 16px; }
  .form-more summary { cursor: pointer; font-weight: 600; min-height: 28px; }
  .form-more[open] summary { margin-bottom: 12px; }
  .req { color: #c0392b; }
  .field.is-invalid input, .field.is-invalid select, .field.is-invalid textarea, .field.is-invalid .picker-input, input.is-invalid { border-color: #c0392b; outline: 2px solid rgba(192, 57, 43, 0.25); }
  .field.is-invalid label, .field.is-invalid legend { color: #c0392b; }
  .field-error { color: #c0392b; font-weight: 600; }
  .field-error[hidden], .link-preview[hidden] { display: none; }
  .link-preview { max-width: 220px; max-height: 220px; margin-top: 6px; object-fit: contain; border: 1px solid var(--border); border-radius: 8px; }
  /* stato: interruttore grande in cima */
  .status-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px; padding: 12px 16px; background: var(--surface); border: 1px solid var(--border); border-radius: 12px; }
  .status-switch { display: inline-flex; padding: 3px; background: var(--bg); border: 1px solid var(--border); border-radius: 999px; }
  .status-switch button { min-height: 40px; padding: 6px 16px; font-weight: 600; color: var(--muted); background: transparent; border: 0; border-radius: 999px; }
  .status-switch button[aria-pressed='true'] { color: #fff; background: #8a8a8a; }
  .status-bar[data-value='published'] .status-switch button[aria-pressed='true'] { background: #2e8b57; }
  .status-bar[data-value='draft'] .status-switch button[aria-pressed='true'] { background: #b26a12; }
  /* scorciatoie delle date */
  .date-shortcuts { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 2px; }
  .date-shortcuts .chip { min-height: 32px; padding: 4px 10px; font-size: 0.85rem; color: var(--accent); background: var(--accent-soft); border: 0; border-radius: 999px; }
  .date-shortcuts .chip.ghost { color: var(--muted); background: transparent; border: 1px solid var(--border); }
  /* Salva sempre a portata, in fondo allo schermo */
  .form-save { position: sticky; bottom: 0; z-index: 20; align-items: center; margin: 0; padding: 10px 16px; background: var(--surface); border: 1px solid var(--border); border-radius: 12px; box-shadow: 0 -6px 16px rgba(0, 0, 0, 0.08); }
  .form-save button[type='submit'] { min-width: 140px; min-height: 44px; font-weight: 700; }
  .form-save small { margin-left: auto; }
  /* Da approvare: promozioni ed eventi con l'aspetto del modulo */
  .review-origin { background: var(--accent-soft); }
  .review-origin .summary { margin: 0; }
  .review-origin details { margin-top: 10px; }
  .hint { margin: 0 0 10px; padding: 8px 12px; background: var(--surface); border-radius: 8px; }
  .big-check { min-height: 44px; margin-bottom: 8px; }
  .big-check input { width: 22px; height: 22px; }
  .raw-data { padding: 0 4px; color: var(--muted); font-size: 0.9rem; }
  .raw-data pre { overflow-x: auto; white-space: pre-wrap; }
  /* copertina dell'edizione (bindCoverFields) */
  .cover-field { display: flex; flex-wrap: wrap; gap: 16px; align-items: flex-start; }
  .cover-field.is-uploading { opacity: 0.6; pointer-events: none; }
  .cover-frame { position: relative; display: grid; place-items: center; width: 140px; aspect-ratio: 2 / 3; flex: none; overflow: hidden; background: var(--bg); border: 1px dashed var(--border); border-radius: 6px; }
  .cover-frame img { width: 100%; height: 100%; object-fit: cover; }
  .cover-empty { padding: 8px; font-size: 0.85rem; text-align: center; color: var(--muted); }
  .cover-empty[hidden], .cover-preview[hidden], .cover-link[hidden], .cover-found[hidden], [data-cover-remove][hidden] { display: none; }
  .cover-actions { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; flex: 1 1 240px; min-width: 0; }
  .cover-btn { min-height: 44px; display: inline-flex; align-items: center; font-size: 1rem; cursor: pointer; }
  .cover-link { display: flex; flex-wrap: wrap; gap: 6px; width: 100%; }
  .cover-link input { flex: 1 1 200px; min-height: 44px; }
  .cover-found { display: flex; align-items: flex-end; gap: 10px; }
  .cover-found img { width: 90px; aspect-ratio: 2 / 3; object-fit: cover; border-radius: 4px; box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2); }
  .cover-msg:empty { display: none; }
  .change-cover { margin-top: 6px; font-size: 0.9rem; }
  @media (max-width: 760px) {
    .cover-actions, .cover-btn { width: 100%; }
    .cover-btn { justify-content: center; }
  }
  /* Opere: pubblica dall'elenco */
  .row-publish { margin: 6px 0 0 34px; min-height: 36px; padding: 4px 14px; font-size: 0.9rem; font-weight: 600; background: #2e8b57; border-color: #2e8b57; }
  .row-published { display: block; margin: 6px 0 0 34px; color: #2e8b57; font-weight: 600; }
  /* anteprima dal vivo */
  .form-preview p { margin: 0 0 8px; }
  .pv-coupon, .pv-ticket { color: #3a2a1f; background: #fff8ec; border: 2px dashed #d7a86e; border-radius: 14px; }
  .pv-coupon { display: flex; flex-direction: column; gap: 4px; padding: 16px; }
  .pv-kind { font-size: 0.75rem; font-weight: 700; color: #a0522d; }
  .pv-reward { font-family: var(--font-display); font-size: 1.35rem; line-height: 1.2; }
  .pv-title { font-weight: 600; }
  .pv-cond, .pv-foot { font-size: 0.85rem; opacity: 0.8; }
  .pv-when { align-self: flex-start; margin-top: 6px; padding: 2px 10px; font-size: 0.8rem; font-weight: 700; color: #fff; background: #a0522d; border-radius: 999px; }
  .pv-ticket { display: flex; overflow: hidden; border-style: solid; }
  .pv-stub { display: flex; flex-direction: column; align-items: center; justify-content: center; min-width: 76px; padding: 12px 8px; color: #fff; background: #a0522d; border-right: 2px dashed #fff8ec; }
  .pv-stub strong { font-size: 1.4rem; line-height: 1; }
  .pv-stub span { font-size: 0.8rem; text-transform: lowercase; }
  .pv-body { display: flex; flex-direction: column; gap: 4px; padding: 12px 14px; min-width: 0; }
  .pv-body .pv-title { overflow-wrap: anywhere; }
  @media (max-width: 960px) {
    .form-layout.with-preview { grid-template-columns: 1fr; }
    .form-layout.with-preview .form-preview { order: 0; position: static; }
  }
  @media (max-width: 760px) {
    .form-grid { grid-template-columns: 1fr; }
    .form-group, .form-more { padding: 14px 12px; }
    .field input:not([type='checkbox']):not([type='file']), .field select, .field textarea { min-height: 44px; font-size: 16px; }
    .status-switch { width: 100%; }
    .status-switch button { flex: 1; padding: 6px 8px; }
    .form-save { margin: 0 -4px; border-radius: 12px 12px 0 0; }
    .form-save small { display: none; }
    .form-save button { flex: 1; }
  }

  .stats { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 12px; margin-bottom: 16px; }
  .site-card { margin-top: 20px; max-width: 520px; }

  /* post social: comandi a sinistra, anteprime e testo a destra */
  .social { display: grid; grid-template-columns: minmax(260px, 340px) 1fr; gap: 20px; align-items: start; }
  .social-controls { display: flex; flex-direction: column; gap: 6px; position: sticky; top: 16px; }
  .social-controls select { margin-bottom: 8px; }
  .social-controls fieldset { border: 0; padding: 0; margin: 8px 0 0; }
  .social-controls legend { font-weight: 600; margin-bottom: 4px; }
  .formats { display: grid; grid-template-columns: 1fr 1fr; gap: 4px 12px; }
  .social-items { display: flex; flex-direction: column; gap: 6px; max-height: 50vh; overflow-y: auto; }
  .social-item { display: flex; gap: 8px; align-items: flex-start; font-weight: 400; }
  .social-slides { display: flex; gap: 16px; overflow-x: auto; padding-bottom: 8px; }
  .social-slides figure { margin: 0; flex: none; display: flex; flex-direction: column; gap: 8px; align-items: flex-start; }
  .social-slides canvas { width: 300px; height: auto; border-radius: 8px; box-shadow: 0 6px 18px rgba(0, 0, 0, 0.18); }
  .social-slides[data-format='story'] canvas { width: 240px; }
  .social-output textarea { width: 100%; font: inherit; }
  .standalone { max-width: 1200px; margin: 0 auto; padding: 24px; }
  @media (max-width: 800px) {
    .social { grid-template-columns: 1fr; }
    .social-controls { position: static; }
  }
  .site-card h2 { margin: 0 0 8px; font-size: 1.2rem; }
  .site-card p { margin: 0 0 8px; }
  .stat { text-decoration: none; color: var(--text); }
  .stat strong { display: block; font-size: 1.8rem; color: var(--accent); }

  .pill { display: inline-block; padding: 1px 8px; border-radius: 999px; font-size: 0.8rem; background: var(--accent-soft); color: var(--accent); }
  .pill.draft { background: var(--limited-soft); color: var(--limited); }
  .pill.archived { background: var(--border); color: var(--muted); }

  .children { margin-top: 32px; }
  .queue { display: grid; gap: 8px; }
  .queue-tools { display: grid; gap: 8px; margin-bottom: 14px; }
  .queue-filter { display: flex; flex-wrap: wrap; gap: 6px; }
  .queue-filter .pill { text-decoration: none; }
  .queue-filter .pill.is-on { outline: 2px solid currentColor; }
  .queue-bulk { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 16px; }
  /* elenco con copertina e pallino di stato (Opere, Edizioni) */
  /* note personali nella colonna (src/admin/notes.ts): foglietto a righe */
  .notes { margin: 18px 0 6px; }
  .notes summary { margin-bottom: 6px; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); cursor: pointer; list-style: none; }
  .notes summary::-webkit-details-marker { display: none; }
  /* carta chiara in entrambi i temi: testo sempre scuro, altrimenti nel tema scuro sarebbe chiaro su chiaro */
  .notes textarea {
    color: #2a2230;
    width: 100%;
    min-height: 140px;
    padding: 6px 8px;
    font-size: 0.9rem;
    line-height: 22px;
    resize: none;
    background: repeating-linear-gradient(transparent 0 21px, #d8e4f0 21px 22px), #fffdf7;
    background-attachment: local;
    background-position: 0 6px; /* righe allineate al testo (stesso spazio del padding in alto) */
    border: 1px solid var(--border);
    border-left: 3px solid #e3a3a3;
    border-radius: 4px;
  }
  .notes textarea:focus { outline: 2px solid var(--accent-soft); border-color: var(--accent); }
  .notes textarea::placeholder { color: #8c8496; }
  .notes-status { display: block; min-height: 1.2em; margin-top: 2px; font-size: 0.75rem; }
  @media (max-width: 760px) {
    .notes { width: 100%; }
    .notes summary { font-size: 0.9rem; text-transform: none; letter-spacing: 0; }
    .notes summary::after { content: ' ▾'; }
  }
  /* bozza ripristinata (src/admin/draft.ts) */
  .draft-note { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 6px 12px; margin: 10px 0 0; padding: 10px 12px; font-size: 0.92rem; color: #3a2f1a; background: #fff8e8; border: 1px solid #e3c78a; border-radius: 8px; }
  .draft-note .link { color: #8a3f7a; }
  /* suggerimenti (src/admin/suggest.ts) */
  .suggest { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin: 6px 0; padding: 8px 10px; font-size: 0.88rem; color: #3a2f1a; background: #fff8e8; border: 1px dashed #e3c78a; border-radius: 8px; }
  .suggest[hidden] { display: none; }
  .suggest-title { color: #6b5a3a; }
  .suggest .suggest-chip, .suggest .suggest-all { color: #8a3f7a; background: #fff; border-color: #ead6e3; }
  .suggest small { color: #6b5a3a; }
  .suggest-chip, .suggest-all { padding: 4px 10px; font-size: 0.88rem; color: var(--accent); background: var(--surface); border: 1px solid var(--accent-soft); border-radius: 999px; cursor: pointer; }
  .suggest-chip:hover, .suggest-all:hover { border-color: var(--accent); }
  .suggest-all { font-weight: 600; }
  .form-head { display: flex; align-items: center; gap: 14px; }
  .form-head h1 { margin: 0; }
  .form-cover { width: 64px; height: 92px; flex: none; object-fit: cover; border-radius: 3px; box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2); }
  .list-title { display: inline-flex; align-items: center; gap: 10px; }
