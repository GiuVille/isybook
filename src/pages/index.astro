---
import Base from '../layouts/Base.astro';
import EditionCard from '../components/EditionCard.astro';
import EventCard from '../components/EventCard.astro';
import ForYou from '../components/ForYou.astro';
import WeekDrawer from '../components/WeekDrawer.astro';
import { getEditionsWithWork, getEvents } from '../lib/data';

const today = new Date().toISOString().slice(0, 10);
const editions = await getEditionsWithWork();
const upcoming = editions.filter((e) => (e.release_date ?? '9999') >= today).slice(0, 6);
const special = editions.filter((e) => e.edition_type !== 'standard').slice(0, 6);
const events = (await getEvents()).filter((e) => (e.ends_on ?? e.starts_on) >= today).slice(0, 3);
---

<Base title="IsyBook – il radar delle uscite">
  <WeekDrawer editions={editions} />
  <p class="intro muted">Uscite, edizioni speciali, serie tratte dai libri ed eventi di romantasy, romance e fantasy YA, in un posto solo.</p>

  <ForYou />

  <div class="section-head">
    <h2>Edizioni speciali e limitate</h2>
    <a href="/libri?edizioni=special,limited">Tutte le edizioni speciali →</a>
  </div>
  <div class="grid">{special.map((e) => <EditionCard edition={e} />)}</div>

  <h2>Prossime uscite</h2>
  {upcoming.length ? <div class="grid">{upcoming.map((e) => <EditionCard edition={e} />)}</div> : <p class="muted">Nessuna uscita in calendario.</p>}

  {events.length > 0 && (
    <>
      <div class="section-head">
        <h2>Prossimi eventi</h2>
        <a href="/eventi">Tutto il calendario →</a>
      </div>
      <div class="events">{events.map((e) => <EventCard event={e} />)}</div>
    </>
  )}
</Base>

<style>
  .intro { margin: 18px 0 0; }
  h2 { margin-top: 40px; }
  .section-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 8px; margin-top: 40px; }
  .section-head h2 { margin: 0 0 12px; }
  .events { display: grid; gap: 12px; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); }
  @media (max-width: 700px) { .events { grid-template-columns: minmax(0, 1fr); } }
</style>
