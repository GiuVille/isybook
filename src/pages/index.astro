---
import Base from '../layouts/Base.astro';
import EditionCard from '../components/EditionCard.astro';
import EventTicket from '../components/EventTicket.astro';
import ForYou from '../components/ForYou.astro';
import PostIt from '../components/PostIt.astro';
import PromoCoupon from '../components/PromoCoupon.astro';
import ReleaseCarousel from '../components/ReleaseCarousel.astro';
import { getEditionsWithWork, getEvents, getNews, getPromotions } from '../lib/data';
import { promotionState } from '../lib/promotions';
import { groupEditions, upcomingReleases } from '../lib/releases';
import '../styles/bacheca.css';

const today = new Date().toISOString().slice(0, 10);
const editions = await getEditionsWithWork();
const upcoming = groupEditions(editions.filter((e) => (e.release_date ?? '9999') >= today)).slice(0, 6);
const special = editions.filter((e) => e.edition_type !== 'standard').slice(0, 6);
const releases = upcomingReleases(editions, today).slice(0, 8);
// prima quelle che scadono presto
const promotions = (await getPromotions()).filter((p) => !['over', 'upcoming'].includes(promotionState(p, today))).slice(0, 3);
const news = (await getNews()).slice(0, 3);
const events = (await getEvents()).filter((e) => (e.ends_on ?? e.starts_on) >= today).slice(0, 3);
---

<Base title="IsyBooks – il radar delle uscite">
  <div class="section-head first">
    <h1>In arrivo</h1>
    <a href="/uscite">Tutte le uscite →</a>
  </div>
  <ReleaseCarousel releases={releases} />
  <p class="intro muted">Uscite, edizioni speciali, serie tratte dai libri ed eventi di romantasy, romance e fantasy YA, in un posto solo.</p>

  <ForYou />

  {news.length > 0 && (
    <>
      <div class="section-head">
        <h2>Dalla bacheca</h2>
        <a href="/notizie">Tutte le notizie →</a>
      </div>
      <div class="wall compact">
        <div class="hanger" aria-hidden="true"><span class="wire l"></span><span class="wire r"></span><span class="nail"></span></div>
        <div class="board" data-reveal>
          <div class="notes">{news.map((n, i) => <PostIt news={n} index={i} />)}</div>
        </div>
      </div>
    </>
  )}

  {promotions.length > 0 && (
    <>
      <div class="section-head">
        <h2>Promozioni in corso</h2>
        <a href="/promozioni">Tutte le promozioni →</a>
      </div>
      <div class="coupons">{promotions.map((p, i) => <PromoCoupon promotion={p} index={i} />)}</div>
    </>
  )}

  <div class="section-head">
    <h2>Edizioni speciali e limitate</h2>
    <a href="/libri?edizioni=special,limited">Tutte le edizioni speciali →</a>
  </div>
  <div class="grid">{special.map((e, i) => <EditionCard edition={e} index={i} />)}</div>

  <h2>Prossime uscite</h2>
  {upcoming.length ? <div class="grid">{upcoming.map((e, i) => <EditionCard edition={e} index={i} />)}</div> : <p class="muted">Nessuna uscita in calendario.</p>}

  {events.length > 0 && (
    <>
      <div class="section-head">
        <h2>Prossimi eventi</h2>
        <a href="/eventi">Tutto il calendario →</a>
      </div>
      <div class="events">{events.map((e, i) => <EventTicket event={e} index={i} />)}</div>
    </>
  )}
</Base>

<style>
  .intro { margin: 0; }
  .section-head.first { margin-top: 0; }
  .section-head.first h1 { margin: 0 0 6px; }
  h2 { margin-top: 40px; }
  .section-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 8px; margin-top: 40px; }
  .section-head h2 { margin: 0 0 12px; }
  .coupons { display: grid; gap: 26px; padding-top: 12px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); }
  .events { display: grid; gap: 18px; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); }
  @media (max-width: 700px) { .events { grid-template-columns: minmax(0, 1fr); } }
</style>
