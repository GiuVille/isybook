---
import Base from '../layouts/Base.astro';
import '../styles/drawer.css';
---

<Base title="La mia libreria" description="I tuoi libri preferiti e le tue cartelle personali.">
  <div class="page-head">
    <h1>La mia libreria</h1>
    <form class="new-collection">
      <input type="text" maxlength="40" placeholder="Nome della nuova cartella…" aria-label="Nome della nuova cartella" />
      <button type="submit" class="button-strong">Crea cartella</button>
    </form>
  </div>

  <p class="notice">
    I tuoi libri sono salvati solo su questo browser: niente account e nessun dato inviato a noi.
    Presto potrai creare un account per ritrovarli su tutti i dispositivi. Nel frattempo puoi fare un backup qui sotto.
  </p>

  <div id="library">
    <div class="lib-drawer" role="tablist" aria-label="Le tue raccolte"><p class="muted">Caricamento…</p></div>
    <div class="drawer-panel" role="tabpanel"></div>
  </div>

  <section class="interests">
    <h2>I tuoi interessi</h2>
    <div class="interests-body"></div>
    <button type="button" class="button-soft edit-interests">Modifica interessi</button>
  </section>

  <section class="backup">
    <h2>Backup</h2>
    <p class="muted">Scarica i tuoi dati per non perderli se cambi browser, o ripristina un backup.</p>
    <div class="backup-actions">
      <button type="button" class="button-soft export">Esporta</button>
      <label class="button-soft import">
        Importa
        <input type="file" accept="application/json,.json" hidden />
      </label>
    </div>
  </section>
</Base>

<script>
  import { bookCard, esc, miniCover } from '../lib/book-card';
  import { loadCatalog, type Catalog, type CatalogBook } from '../lib/catalog';
  import {
    createCollection,
    deleteCollection,
    exportLibrary,
    getLibrary,
    importLibrary,
    onLibraryChange,
    removeFromCollection,
    renameCollection,
    toggleFavorite,
  } from '../lib/library';

  const root = document.getElementById('library')!;
  const drawer = root.querySelector<HTMLElement>('.lib-drawer')!;
  const panel = root.querySelector<HTMLElement>('.drawer-panel')!;
  const FAVORITES = 'preferiti';
  // cartellina aperta: dall'URL (#cartella-<id>), altrimenti i Preferiti
  let selected = location.hash.startsWith('#cartella-') ? decodeURIComponent(location.hash.slice('#cartella-'.length)) : FAVORITES;
  let firstRender = true;
  const interestsBody = document.querySelector<HTMLElement>('.interests-body')!;
  let catalog: Catalog | null = null;

  const books = (slugs: string[]) =>
    slugs.map((s) => catalog!.books.find((b) => b.slug === s)).filter((b): b is CatalogBook => Boolean(b));

  const removeButton = (attrs: string) => `<button type="button" class="remove" ${attrs}>Rimuovi</button>`;

  function section(title: string, list: CatalogBook[], opts: { id?: string; empty: string; tools?: string }) {
    return `
      <section class="shelf" ${opts.id ? `data-collection="${esc(opts.id)}"` : ''}>
        <div class="shelf-head">
          <h2>${title} <span class="count">${list.length}</span></h2>
          ${opts.tools ?? ''}
        </div>
        ${
          list.length
            ? `<div class="mini-books">${list
                .map((b) =>
                  bookCard(b, {
                    action: opts.id
                      ? removeButton(`data-remove="${esc(b.slug)}" data-from="${esc(opts.id)}"`)
                      : removeButton(`data-unfav="${esc(b.slug)}"`),
                  }),
                )
                .join('')}</div>`
            : `<p class="empty muted">${opts.empty}</p>`
        }
      </section>`;
  }

  type Folder = { id: string; name: string; slugs: string[]; color: number };

  function folders(): Folder[] {
    const library = getLibrary();
    return [
      { id: FAVORITES, name: 'Preferiti', slugs: library.favorites, color: 2 },
      ...library.collections.map((c, i) => ({ id: c.id, name: c.name, slugs: c.slugs, color: [1, 3, 4, 5, 6][i % 5] })),
    ];
  }

  function folderButton(folder: Folder, index: number) {
    const list = books(folder.slugs);
    const isSelected = folder.id === selected;
    return `
      <li class="wk" style="--d:${index}">
        <button type="button" class="folder-btn" role="tab" id="tab-${esc(folder.id)}" data-folder="${esc(folder.id)}"
          aria-selected="${isSelected}" tabindex="${isSelected ? 0 : -1}" style="--f:var(--folder-${folder.color})">
          <span class="fan" aria-hidden="true">${list.slice(0, 3).map(miniCover).join('')}</span>
          <span class="front">
            <span class="tab"><span class="label">${folder.id === FAVORITES ? '❤ ' : ''}${esc(folder.name)}</span></span>
            <span class="count-big">${list.length}</span>
            <span class="count-label">${list.length === 1 ? 'libro' : 'libri'}</span>
            ${list.length === 0 ? '<span class="empty-note">vuota</span>' : ''}
          </span>
        </button>
      </li>`;
  }

  function render() {
    if (!catalog) return;
    const library = getLibrary();
    const all = folders();
    if (!all.some((f) => f.id === selected)) selected = FAVORITES;

    drawer.innerHTML = `<ol class="row">
        ${all.map(folderButton).join('')}
        <li class="wk" style="--d:${all.length}">
          <button type="button" class="folder-btn new-folder" data-new>
            <span class="front"><span class="plus">+</span><span class="count-label">Nuova cartella</span></span>
          </button>
        </li>
      </ol>`;
    drawer.classList.toggle('is-first', firstRender);
    // senza copertine da mostrare il cassetto si abbassa
    drawer.classList.toggle('no-covers', all.every((f) => books(f.slugs).length === 0));
    firstRender = false;

    const current = all.find((f) => f.id === selected)!;
    panel.setAttribute('aria-labelledby', `tab-${current.id}`);
    panel.innerHTML =
      current.id === FAVORITES
        ? section('❤ Preferiti', books(current.slugs), {
            empty: 'Ancora nessun preferito: tocca il cuore su un libro per salvarlo qui. <a href="/libri">Sfoglia i libri</a>',
          })
        : section(`📁 ${esc(current.name)}`, books(current.slugs), {
            id: current.id,
            empty: 'Cartella vuota: aggiungi libri dal pulsante «Cartella» nella scheda di un libro.',
            tools: `<span class="tools">
              <button type="button" class="link" data-rename="${esc(current.id)}">Rinomina</button>
              <button type="button" class="link danger" data-delete="${esc(current.id)}">Elimina</button>
            </span>`,
          });
    if (library.collections.length === 0) {
      panel.insertAdjacentHTML(
        'beforeend',
        '<p class="muted hint">Crea una cartella per organizzare i libri come vuoi: «Da leggere», «Regali», «Edizioni da cacciare»…</p>',
      );
    }

    const i = library.interests;
    const names = (slugs: string[], list: Catalog['tropes']) =>
      slugs.map((s) => list.find((t) => t.slug === s)?.name).filter(Boolean) as string[];
    const chosen = i
      ? [...names(i.genres, catalog.genres), ...names(i.tropes, catalog.tropes), ...names(i.settings, catalog.settings)]
      : [];
    interestsBody.innerHTML = chosen.length
      ? `<p class="chips">${chosen.map((n) => `<span class="tag">${esc(n)}</span>`).join('')}</p>`
      : '<p class="muted">Non hai ancora indicato i tuoi interessi.</p>';
  }

  function select(id: string, focus = false) {
    if (id === selected) return;
    selected = id;
    history.replaceState(null, '', id === FAVORITES ? location.pathname : `#cartella-${encodeURIComponent(id)}`);
    render();
    panel.classList.remove('is-changing');
    void panel.offsetWidth;
    panel.classList.add('is-changing');
    if (focus) drawer.querySelector<HTMLElement>(`[data-folder="${CSS.escape(id)}"]`)?.focus();
  }

  drawer.addEventListener('click', (e) => {
    const button = (e.target as HTMLElement).closest<HTMLButtonElement>('.folder-btn');
    if (!button) return;
    if (button.dataset.new !== undefined) {
      const input = document.querySelector<HTMLInputElement>('.new-collection input')!;
      input.scrollIntoView({ block: 'center', behavior: 'smooth' });
      input.focus({ preventScroll: true });
      return;
    }
    select(button.dataset.folder!);
  });
  drawer.addEventListener('keydown', (e) => {
    if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
    const ids = folders().map((f) => f.id);
    const i = ids.indexOf(selected);
    const next = ids[(i + (e.key === 'ArrowRight' ? 1 : -1) + ids.length) % ids.length];
    e.preventDefault();
    select(next, true);
  });

  root.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    if (t.dataset.unfav) toggleFavorite(t.dataset.unfav);
    if (t.dataset.remove && t.dataset.from) removeFromCollection(t.dataset.from, t.dataset.remove);
    if (t.dataset.rename) {
      const current = getLibrary().collections.find((c) => c.id === t.dataset.rename);
      const name = prompt('Nuovo nome della cartella', current?.name ?? '');
      if (name) renameCollection(t.dataset.rename, name);
    }
    if (t.dataset.delete) {
      const current = getLibrary().collections.find((c) => c.id === t.dataset.delete);
      if (confirm(`Eliminare la cartella «${current?.name}»? I libri restano nel sito, sparisce solo la cartella.`)) {
        deleteCollection(t.dataset.delete);
      }
    }
  });

  document.querySelector('.new-collection')!.addEventListener('submit', (e) => {
    e.preventDefault();
    const input = (e.target as HTMLFormElement).querySelector('input')!;
    if (!input.value.trim()) return input.focus();
    const created = createCollection(input.value);
    input.value = '';
    select(created.id);
  });

  document.querySelector('.edit-interests')!.addEventListener('click', () =>
    window.dispatchEvent(new Event('open-onboarding')),
  );

  document.querySelector('.export')!.addEventListener('click', () => {
    const blob = new Blob([exportLibrary()], { type: 'application/json' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = `isybook-libreria-${new Date().toISOString().slice(0, 10)}.json`;
    a.click();
    URL.revokeObjectURL(a.href);
  });

  document.querySelector<HTMLInputElement>('.import input')!.addEventListener('change', async (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (!file) return;
    if (!confirm('Il backup sostituirà preferiti, cartelle e interessi salvati ora. Continuare?')) return;
    try {
      importLibrary(await file.text());
    } catch {
      alert('Questo file non sembra un backup di IsyBook.');
    }
  });

  loadCatalog()
    .then((c) => {
      catalog = c;
      render();
    })
    .catch(() => {
      drawer.innerHTML = '<p class="muted">Non riesco a caricare i libri in questo momento.</p>';
    });
  onLibraryChange(render);
</script>

<style>
  .page-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; }
  h1 { margin: 0; }
  .new-collection { display: flex; gap: 8px; flex: 0 1 420px; }
  .new-collection input {
    flex: 1;
    min-width: 0;
    padding: 8px 14px;
    font: inherit;
    color: inherit;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 999px;
  }
  .notice {
    margin: 16px 0 8px;
    padding: 12px 16px;
    font-size: 0.9rem;
    background: var(--accent-soft);
    border-radius: var(--radius);
  }

  #library { margin-top: 28px; }
  .drawer-panel :global(.shelf) { margin-top: 28px; }
  #library :global(.shelf-head) { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 8px; }
  #library :global(h2) { margin: 0 0 12px; font-size: 1.35rem; }
  #library :global(.count) { font-family: var(--font-text); font-size: 0.85rem; font-weight: 400; color: var(--muted); }
  #library :global(.tools) { display: flex; gap: 12px; }
  #library :global(.link) { font: inherit; font-size: 0.85rem; color: var(--accent); background: none; border: 0; padding: 0; cursor: pointer; text-decoration: underline; }
  #library :global(.link.danger) { color: var(--limited); }
  #library :global(.empty) {
    margin: 0;
    padding: 20px;
    border: 1px dashed var(--border);
    border-radius: var(--radius);
  }
  #library :global(.hint) { margin-top: 24px; }

  .interests, .backup { margin-top: 40px; }
  .interests h2, .backup h2 { font-size: 1.35rem; margin: 0 0 8px; }
  .interests-body :global(.chips) { display: flex; flex-wrap: wrap; gap: 6px; }
  .backup-actions { display: flex; gap: 8px; }
  .import { cursor: pointer; }
</style>
