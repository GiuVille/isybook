---
import Base from '../../layouts/Base.astro';
import CatalogFilters, { type FilterGroup, type FilterOption } from '../../components/CatalogFilters.astro';
import EventCard from '../../components/EventCard.astro';
import { slugify } from '../../admin/resources';
import { getEvents, getWorks } from '../../lib/data';
import { EVENT_KIND_LABELS } from '../../lib/format';
import type { BookEvent, Tag } from '../../lib/types';

const today = new Date().toISOString().slice(0, 10);
const [events, works] = await Promise.all([getEvents(), getWorks()]);
// un evento di più giorni resta tra i prossimi finché non è finito
const upcoming = events.filter((e) => (e.ends_on ?? e.starts_on) >= today);
const past = events.filter((e) => (e.ends_on ?? e.starts_on) < today).reverse();

const monthLabel = (iso: string) => {
  const label = new Date(`${iso.slice(0, 7)}-01`).toLocaleDateString('it-IT', { month: 'long', year: 'numeric' });
  return label.charAt(0).toUpperCase() + label.slice(1);
};
const byMonth = Map.groupBy(upcoming, (e) => monthLabel(e.starts_on));

// generi dei libri collegati a ciascun evento
const genresOf = (e: BookEvent): Tag[] =>
  [...new Map(works.filter((w) => e.works.some((x) => x.slug === w.slug)).flatMap((w) => w.genres).map((g) => [g.slug, g])).values()];

function unique(items: FilterOption[]): FilterOption[] {
  return [...new Map(items.map((i) => [i.slug, i])).values()].sort((a, b) => a.name.localeCompare(b.name, 'it'));
}

const groups: FilterGroup[] = [
  { key: 'autori', attr: 'authors', label: 'Autori', mode: 'any', options: unique(upcoming.flatMap((e) => e.authors)) },
  {
    key: 'citta', attr: 'city', label: 'Città', mode: 'any',
    options: unique(upcoming.filter((e) => e.city).map((e) => ({ slug: slugify(e.city!), name: e.city! }))),
  },
  {
    key: 'tipo', attr: 'kind', label: 'Tipo', mode: 'any',
    options: unique(upcoming.map((e) => ({ slug: e.kind, name: EVENT_KIND_LABELS[e.kind] }))),
  },
  {
    // il mese resta in ordine di calendario, non alfabetico
    key: 'mese', attr: 'month', label: 'Mese', mode: 'any',
    options: [...new Map(upcoming.map((e) => [e.starts_on.slice(0, 7), { slug: e.starts_on.slice(0, 7), name: monthLabel(e.starts_on) }])).values()],
  },
  { key: 'libri', attr: 'works', label: 'Libri', mode: 'any', options: unique(upcoming.flatMap((e) => e.works.map((w) => ({ slug: w.slug, name: w.title })))) },
  { key: 'generi', attr: 'genres', label: 'Generi', mode: 'any', options: unique(upcoming.flatMap(genresOf)) },
];
---

<Base
  title="Eventi e fiere"
  hideSearch
  description="Firmacopie, presentazioni e fiere del libro: il calendario per chi ama romantasy, romance e fantasy YA."
>
  <h1>Eventi e fiere</h1>
  <p class="muted intro">Firmacopie, presentazioni e fiere del libro in Italia. Aggiungi al tuo calendario quelli che non vuoi perdere.</p>

  {upcoming.length > 0 ? (
    <CatalogFilters
      groups={groups}
      placeholder="Cerca evento, autore, libro, città…"
      noun={{ one: 'evento', many: 'eventi' }}
      itemSelector=".months article.event"
      sectionSelector=".months .month"
    />
  ) : (
    <p class="empty-all">Per ora non ci sono eventi in calendario. Torna presto!</p>
  )}

  <div class="months">
    {[...byMonth].map(([month, list]) => (
      <section class="month">
        <h2>{month}</h2>
        <div class="list">{list.map((e) => <EventCard event={e} genres={genresOf(e)} />)}</div>
      </section>
    ))}
  </div>

  {past.length > 0 && (
    <details class="past">
      <summary>Eventi passati ({past.length})</summary>
      <div class="list">{past.map((e) => <EventCard event={e} />)}</div>
    </details>
  )}
</Base>

<style>
  .intro { margin-top: -8px; }
  .month h2 { margin: 28px 0 12px; font-size: 1.3rem; }
  .list { display: grid; gap: 12px; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); }
  .empty-all { margin-top: 24px; padding: 24px; text-align: center; border: 1px dashed var(--border); border-radius: var(--radius); }
  .past { margin-top: 40px; }
  .past summary { cursor: pointer; font-weight: 600; margin-bottom: 12px; }
  .past .list { opacity: 0.75; }
  @media (max-width: 700px) {
    .list { grid-template-columns: minmax(0, 1fr); }
  }
</style>
