---
import Base from '../../layouts/Base.astro';
import { getArticles, getSections } from '../../lib/data';
import type { Article, Section } from '../../lib/types';

export async function getStaticPaths() {
  const [sections, articles] = await Promise.all([getSections(), getArticles()]);
  return sections.map((section) => ({
    params: { slug: section.slug },
    props: { section, articles: articles.filter((a) => a.section?.id === section.id) },
  }));
}

const { section, articles } = Astro.props as { section: Section; articles: Article[] };
---

<Base title={section.name} description={section.description ?? undefined}>
  <h1>{section.name}</h1>
  {section.description && <p class="muted">{section.description}</p>}
  {articles.length === 0 && <p class="muted">Nessun articolo in questa rubrica.</p>}
  <ul>{articles.map((a) => <li><a href={`/articoli/${a.slug}`}>{a.title}</a></li>)}</ul>
</Base>
