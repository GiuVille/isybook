---
import Base from '../../layouts/Base.astro';
import CoverArt from '../../components/CoverArt.astro';
import SaveButtons from '../../components/SaveButtons.astro';
import { themeForWork } from '../../lib/book-themes';
import { getAdaptations, getWorks } from '../../lib/data';
import {
  ADAPTATION_KIND_LABELS,
  WATCH_KIND_LABELS,
  adaptationFacts,
  adaptationWhen,
  formatRuntime,
} from '../../lib/format';
import { similarToAdaptation, type SimilarItem } from '../../lib/similar';
import type { Adaptation, Work } from '../../lib/types';
import { youtubeId, youtubeThumb, youtubeEmbed, youtubeWatch } from '../../lib/youtube';
import { promoImage } from '../../lib/promo-image';

export async function getStaticPaths() {
  const [adaptations, works] = await Promise.all([getAdaptations(), getWorks()]);
  return adaptations.map((adaptation) => ({
    params: { slug: adaptation.slug },
    props: {
      adaptation,
      source: works.find((w) => w.slug === adaptation.source.slug)!,
      similar: similarToAdaptation(adaptation, adaptations, works),
    },
  }));
}

const { adaptation: a, source, similar } = Astro.props as { adaptation: Adaptation; source: Work; similar: SimilarItem[] };
const theme = themeForWork(a);
const kindLabel = ADAPTATION_KIND_LABELS[a.kind];
const tmdb = a.tmdb_id ? `https://www.themoviedb.org/${a.kind === 'film' ? 'movie' : 'tv'}/${a.tmdb_id}` : null;
const trailer = youtubeId(a.trailer_url);
// la miniatura arriva dalla build: finché non si preme play il browser non contatta YouTube
const trailerThumb = trailer ? await promoImage(youtubeThumb(trailer)) : null;
---

<Base title={`${a.title} (${kindLabel.toLowerCase()})`} description={a.plot?.slice(0, 155) ?? `${kindLabel} tratto da ${a.source.title}.`}>
  <article>
    <div class="head">
      <CoverArt
        art={{ id: a.id, title: a.title, caption: kindLabel, image: a.poster_url, color: theme.cover, variant: 'poster' }}
        class="poster"
      />
      <div class="info">
        <p class="kicker">{kindLabel}{a.platform && ` · ${a.platform}`}</p>
        <h1>{a.title}</h1>
        <p class="byline">Tratto da <a href={`/libri/${a.source.slug}`}>{a.source.title}</a> di {a.source.authors.map((x, i) => <>{i > 0 && ', '}<a href={`/autori/${x.slug}`}>{x.name}</a></>)}</p>

        <div class="save-row"><SaveButtons slug={a.slug} title={a.title} kind="screen" /></div>

        <dl class="facts">
          <dt>{a.release_date ? 'Uscita' : 'Stato'}</dt>
          <dd>{adaptationWhen(a)}</dd>
          {a.kind === 'series' && (a.seasons || a.episodes) && (
            <>
              <dt>Stagioni</dt>
              <dd>{adaptationFacts(a).replace('Serie TV · ', '')}</dd>
            </>
          )}
          {a.kind === 'film' && a.runtime_minutes && (
            <>
              <dt>Durata</dt>
              <dd>{formatRuntime(a.runtime_minutes)}</dd>
            </>
          )}
          {a.genres.length > 0 && (
            <>
              <dt>Generi</dt>
              <dd>
                {a.genres.map((g) => <a class="tag" href={`/serie-e-film?generi=${g.slug}`}>{g.name}</a>)}
                {a.inherited.genres && <span class="from-book">dal libro</span>}
              </dd>
            </>
          )}
          {a.tropes.length > 0 && (
            <>
              <dt>Tropes</dt>
              <dd>
                {a.tropes.map((t) => <a class="tag trope" href={`/serie-e-film?tropes=${t.slug}`}>{t.name}</a>)}
                {a.inherited.tropes && <span class="from-book">dal libro</span>}
              </dd>
            </>
          )}
        </dl>
      </div>
    </div>

    {a.plot && (
      <section>
        <h2>Trama</h2>
        <p class="plot">{a.plot}</p>
      </section>
    )}

    {trailer && (
      <section class="trailer-section">
        <h2>Trailer</h2>
        <div class="trailer" data-embed={youtubeEmbed(trailer)} data-title={`Trailer di «${a.title}»`}>
          <a class="trailer-play" href={youtubeWatch(trailer)} target="_blank" rel="noopener" aria-label={`Guarda il trailer di «${a.title}»`}>
            {trailerThumb && <img src={trailerThumb.src} srcset={trailerThumb.srcset} sizes="(max-width: 760px) 100vw, 720px" alt="" loading="lazy" width={trailerThumb.width} height={trailerThumb.height} />}
            <span class="trailer-btn" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M8 5v14l11-7Z" /></svg>
            </span>
          </a>
        </div>
        <p class="muted small">Il video si carica da YouTube quando premi play.</p>
      </section>
    )}

    <section>
      <h2>Dove vederlo</h2>
      {a.watch_providers.length > 0 ? (
        <>
          <ul class="providers">
            {a.watch_providers.map((p) => (
              <li class="card provider">
                <strong>{p.platform}</strong>
                <span class={`kind ${p.kind}`}>{WATCH_KIND_LABELS[p.kind]}</span>
                {p.url && <a href={p.url} target="_blank" rel="noopener">Vai alla piattaforma</a>}
              </li>
            ))}
          </ul>
          <p class="muted small">Disponibilità in Italia: può cambiare, controlla sempre sulla piattaforma.</p>
        </>
      ) : (
        <p class="muted">{a.release_date ? 'Al momento non risulta disponibile in streaming in Italia.' : 'Non è ancora uscito: lo aggiungeremo appena sarà disponibile.'}</p>
      )}
      {tmdb && <p class="small"><a href={tmdb} target="_blank" rel="noopener">Scheda su TMDB</a></p>}
    </section>

    <section>
      <h2>Il libro</h2>
      <a class="card book" href={`/libri/${source.slug}`}>
        <CoverArt work={source} class="mini-cover" />
        <span>
          <strong>{source.title}</strong>
          <span class="muted small block">{source.authors.map((x) => x.name).join(', ')}</span>
          <span class="small block accent">Leggi il libro da cui è nato →</span>
        </span>
      </a>
    </section>

    {similar.length > 0 && (
      <section>
        <h2>Ti potrebbero piacere</h2>
        <div class="similar">
          {similar.map((s) => (
            <a class="card similar-item" href={s.kind === 'adaptation' ? `/serie-e-film/${s.slug}` : `/libri/${s.slug}`}>
              {s.kind === 'adaptation' ? (
                <CoverArt
                  art={{ id: s.adaptation!.id, title: s.title, caption: s.caption, image: s.adaptation!.poster_url, color: themeForWork(s.adaptation!).cover, variant: 'poster' }}
                  class="mini-cover"
                />
              ) : (
                <CoverArt work={s.work!} class="mini-cover" />
              )}
              <span>
                <span class="muted small block">{s.kind === 'adaptation' ? s.caption : 'Libro'}</span>
                <strong>{s.title}</strong>
                <span class="small block accent">{s.reason}</span>
              </span>
            </a>
          ))}
        </div>
      </section>
    )}
  </article>
<p class="tmdb-credit muted small">
    Dati di serie e film da <a href="https://www.themoviedb.org/" target="_blank" rel="noopener">TMDB</a>: questo sito usa le API di TMDB ma non è approvato né certificato da TMDB.
    Disponibilità in streaming in Italia: dati <a href="https://www.justwatch.com/it" target="_blank" rel="noopener">JustWatch</a>.
  </p>
</Base>

<script>
  // trailer: il lettore di YouTube (versione senza cookie) si carica solo al clic, al posto della miniatura
  document.querySelectorAll<HTMLElement>('.trailer').forEach((box) => {
    box.querySelector('.trailer-play')?.addEventListener('click', (e) => {
      e.preventDefault();
      const frame = document.createElement('iframe');
      frame.src = box.dataset.embed!;
      frame.title = box.dataset.title!;
      frame.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      frame.allowFullscreen = true;
      frame.referrerPolicy = 'strict-origin-when-cross-origin';
      box.replaceChildren(frame);
      box.classList.add('is-playing');
    });
  });
</script>

<style>
  .head { display: flex; flex-wrap: wrap; gap: 32px; align-items: flex-start; }
  .head :global(.poster) { width: 220px; height: auto; flex-shrink: 0; filter: drop-shadow(4px 8px 10px rgba(0, 0, 0, 0.25)); }
  .info { flex: 1 1 320px; min-width: 0; }
  .kicker { margin: 0 0 4px; font-size: 0.85rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; color: var(--accent); }
  h1 { margin: 0; font-size: clamp(1.8rem, 4vw, 2.4rem); }
  .byline { font-size: 1.05rem; margin: 6px 0 0; }
  .save-row { margin: 12px 0 4px; }
  .facts { display: grid; grid-template-columns: max-content 1fr; gap: 8px 16px; margin: 18px 0 0; align-items: baseline; }
  .facts dt { color: var(--muted); font-size: 0.85rem; }
  .facts dd { margin: 0; display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
  .tag.trope { background: transparent; border: 1px solid var(--accent); }
  .from-book { font-size: 0.8rem; color: var(--muted); font-style: italic; }

  section { margin-top: 40px; }
  .plot { max-width: 70ch; }
  .small { font-size: 0.85rem; }
  .block { display: block; }
  .accent { color: var(--accent); margin-top: 4px; }

  .providers { list-style: none; margin: 0 0 8px; padding: 0; display: grid; gap: 10px; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); }
  .provider { display: flex; flex-direction: column; gap: 4px; }
  .kind { align-self: flex-start; padding: 1px 10px; font-size: 0.78rem; font-weight: 600; border-radius: 999px; background: var(--accent-soft); color: var(--accent); }
  .kind.free { background: #e3f3e6; color: #2e7d4f; }
  .kind.rent, .kind.buy { background: var(--limited-soft); color: var(--limited); }

  .book, .similar-item { display: flex; gap: 14px; align-items: flex-start; text-decoration: none; color: var(--text); }
  .book { max-width: 420px; }
  .book:hover, .similar-item:hover { border-color: var(--accent); }
  .book :global(.mini-cover), .similar-item :global(.mini-cover) { width: 64px; height: auto; flex-shrink: 0; filter: drop-shadow(2px 3px 4px rgba(0, 0, 0, 0.2)); }
  .similar { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 16px; }

  @media (max-width: 700px) {
    .head :global(.poster) { width: 160px; }
  }
  /* trailer: schermo con cornice scura, miniatura e pulsante play */
  .trailer {
    position: relative;
    max-width: 720px;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #1d1a22;
    border: 10px solid #2a2530;
    border-radius: 18px;
    box-shadow: 0 18px 30px -18px rgba(0, 0, 0, 0.6), inset 0 0 0 2px rgba(255, 255, 255, 0.06);
  }
  .trailer-play { display: block; width: 100%; height: 100%; }
  .trailer img { display: block; width: 100%; height: 100%; object-fit: cover; opacity: 0.88; transition: opacity 0.3s, transform 0.5s var(--ease-out); }
  .trailer-btn {
    position: absolute;
    left: 50%;
    top: 50%;
    display: grid;
    place-items: center;
    width: 74px;
    height: 74px;
    margin: -37px 0 0 -37px;
    background: var(--accent);
    border-radius: 50%;
    box-shadow: 0 8px 20px -6px rgba(0, 0, 0, 0.6);
    transition: transform 0.35s var(--ease-spring);
  }
  .trailer-btn svg { width: 34px; height: 34px; margin-left: 4px; fill: #fff; }
  .trailer-play:hover img,
  .trailer-play:focus-visible img { opacity: 1; transform: scale(1.03); }
  .trailer-play:hover .trailer-btn,
  .trailer-play:focus-visible .trailer-btn { transform: scale(1.12); }
  .trailer-play:focus-visible { outline: 3px solid var(--accent); outline-offset: -6px; }
  /* il lettore viene aggiunto al clic: senza :global gli stili della pagina non lo raggiungerebbero */
  .trailer :global(iframe) { display: block; width: 100%; height: 100%; border: 0; }
  @media (prefers-reduced-motion: no-preference) {
    .trailer.is-playing :global(iframe) { animation: trailer-on 0.5s var(--ease-out); }
    .trailer-btn { animation: trailer-pulse 2.4s ease-in-out infinite; }
    .trailer-play:hover .trailer-btn { animation: none; }
  }
  @keyframes trailer-on { from { opacity: 0; transform: scaleY(0.02); } }
  @keyframes trailer-pulse { 0%, 100% { box-shadow: 0 8px 20px -6px rgba(0, 0, 0, 0.6), 0 0 0 0 rgba(255, 255, 255, 0.35); } 50% { box-shadow: 0 8px 20px -6px rgba(0, 0, 0, 0.6), 0 0 0 10px rgba(255, 255, 255, 0); } }
  .tmdb-credit { margin-top: 40px; max-width: 70ch; }
</style>
