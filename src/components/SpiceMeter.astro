---
// Livello spicy da 0 a 5 con peperoncini: pieni fino al livello, solo contorno dopo.
interface Props {
  level: number;
  size?: number;
}

const { level, size = 22 } = Astro.props;
const label = level === 0 ? 'Nessuna scena spicy' : `Spicy ${level} su 5`;
---

<span class="spice" role="img" aria-label={label} title={label}>
  {level === 0 ? (
    <span class="none">Nessuna scena spicy</span>
  ) : (
    [1, 2, 3, 4, 5].map((i) => (
      <svg viewBox="0 0 24 24" width={size} height={size} class={i <= level ? 'on' : 'off'} aria-hidden="true">
        <path
          class="body"
          d="M5.2 8.4c1.4-1.7 4-1.6 5.6-.3 3.6 2.9 7.4 6.4 9.7 11 .6 1.2-.3 2.4-1.5 2-4.9-1.6-9.7-4.7-13-8.6-1.3-1.5-1.9-3-.8-4.1Z"
        />
        <path class="cap" d="M4.6 8.9c-.4-1.6.6-3 2.2-3.3 1.4-.3 2.8.4 3.4 1.6" />
        <path class="stem" d="M7.2 5.6C6.9 3.9 7.6 2.5 9.2 1.8" />
      </svg>
    ))
  )}
</span>

<style>
  .spice { display: inline-flex; align-items: center; gap: 2px; vertical-align: middle; }
  svg { stroke-linecap: round; stroke-linejoin: round; }
  .body { stroke-width: 1.4; }
  .on .body { fill: #d23b2c; stroke: #8f2017; }
  .off .body { fill: none; stroke: currentColor; opacity: 0.4; }
  .cap, .stem { fill: none; stroke: #3f8a3a; stroke-width: 1.8; }
  .off .cap, .off .stem { stroke: currentColor; opacity: 0.4; }
  .none { font-size: 0.85rem; }
</style>
