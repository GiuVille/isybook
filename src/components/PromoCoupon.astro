---
// Promozione come buono da ritagliare: matrice colorata con il tipo, linea tratteggiata con le forbicine,
// premio scritto grande e timbro con la scadenza ("Ultimi giorni!" in rosso quando sta per finire).
// Il timbro si ricalcola nel browser, così resta giusto anche tra un rebuild e l'altro.
import { normalize } from '../lib/format';
import { PROMOTION_CHANNEL_LABELS, PROMOTION_KIND_LABELS, promotionState, stampText } from '../lib/promotions';
import type { Promotion } from '../lib/types';

interface Props {
  promotion: Promotion;
  /** Posizione nella pagina, per sfalsare l'animazione d'ingresso. */
  index?: number;
  /** false nella pagina della promozione: il buono non rimanda a se stesso. */
  linked?: boolean;
}

const { promotion: p, index = 0, linked = true } = Astro.props;
const state = promotionState(p);
const searchText = normalize(
  [p.title, p.reward, p.conditions, p.publisher?.name, PROMOTION_KIND_LABELS[p.kind], p.where_note, ...p.works.map((w) => w.title)]
    .filter(Boolean)
    .join(' '),
);
---

<article
  class:list={['coupon', `k-${p.kind}`, `is-${state}`, { linked }]}
  data-reveal
  style={`--i:${index % 8}`}
  data-publisher={p.publisher?.slug ?? ''}
  data-kind={p.kind}
  data-channel={p.channel}
  data-ends={p.ends_on ?? ''}
  data-starts={p.starts_on ?? ''}
  data-search={searchText}
>
  <svg class="scissors" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="6" cy="6" r="3" /><circle cx="6" cy="18" r="3" />
    <path d="M8.1 8.1 20 18M8.1 15.9 20 6M13 12h.01" />
  </svg>
  <div class="paper">
    <div class="stub" aria-hidden="true"><span>{PROMOTION_KIND_LABELS[p.kind]}</span></div>
    <div class="body">
      <div class="top">
        <p class="from">{p.publisher?.name}</p>
        <span class="stamp" data-stamp>{stampText(p)}</span>
      </div>
      <p class="reward">{p.reward ?? p.title}</p>
      <h3>{linked ? <a href={`/promozioni/${p.slug}`}>{p.title}</a> : p.title}</h3>
      {p.conditions && <p class="conditions">{p.conditions}</p>}
      <p class="where">{p.where_note ?? PROMOTION_CHANNEL_LABELS[p.channel]}</p>
      {p.works.length > 0 && <p class="works">Con {p.works.map((w) => `«${w.title}»`).join(', ')}</p>}
    </div>
  </div>
</article>

<script>
  import { promotionState, stampText } from '../lib/promotions';

  // stato e timbro aggiornati alla data di chi guarda
  for (const coupon of document.querySelectorAll<HTMLElement>('.coupon')) {
    const dates = { starts_on: coupon.dataset.starts || null, ends_on: coupon.dataset.ends || null };
    const state = promotionState(dates);
    coupon.classList.remove('is-upcoming', 'is-active', 'is-ending', 'is-over');
    coupon.classList.add(`is-${state}`);
    const stamp = coupon.querySelector('[data-stamp]');
    if (stamp) stamp.textContent = stampText(dates);
  }
</script>

<style>
  .coupon {
    --k: #c2577f;
    position: relative;
    padding: 7px;
    border: 2px dashed color-mix(in srgb, var(--coupon-ink) 40%, transparent);
    border-radius: 10px;
  }
  .k-gift_with_purchase { --k: #c2577f; }
  .k-bundle { --k: #c8902a; }
  .k-discount { --k: #3f7d4f; }
  .k-contest { --k: #2f6f80; }
  .k-preorder { --k: #6b4a8a; }

  /* forbicine appoggiate sulla linea tratteggiata: al passaggio la percorrono */
  .scissors {
    position: absolute;
    z-index: 3;
    top: -13px;
    left: 14px;
    width: 24px;
    height: 24px;
    padding: 2px;
    fill: none;
    stroke: var(--coupon-ink);
    stroke-width: 1.8;
    stroke-linecap: round;
    background: var(--bg);
    border-radius: 50%;
    transition: left 1.1s var(--ease-in-out), rotate 1.1s var(--ease-in-out);
  }
  .coupon.linked:hover .scissors,
  .coupon.linked:focus-within .scissors { left: calc(100% - 40px); }

  .paper {
    position: relative;
    display: flex;
    height: 100%;
    color: var(--coupon-ink);
    background: var(--coupon-paper) var(--grain);
    border-radius: 5px;
    box-shadow: 0 1px 0 rgba(0, 0, 0, 0.06), 0 8px 18px -12px rgba(0, 0, 0, 0.35);
    overflow: hidden;
  }

  /* matrice: colore del tipo, perforata verso il corpo del buono */
  .stub {
    position: relative;
    flex: 0 0 46px;
    display: grid;
    place-items: center;
    color: #fff;
    background: var(--k) var(--grain);
  }
  .stub::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    right: -5px;
    width: 10px;
    background: radial-gradient(circle at 5px 50%, var(--coupon-paper) 3.5px, transparent 4px) 0 0 / 10px 14px repeat-y;
  }
  .stub span {
    writing-mode: vertical-rl;
    rotate: 180deg;
    font-family: var(--font-hand);
    font-size: 1.15rem;
    white-space: nowrap;
  }

  .body { flex: 1; min-width: 0; padding: 16px 18px 18px 22px; }
  .top { display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; margin: -4px -6px 10px 0; }
  .from { margin: 4px 0 0; min-width: 0; font-size: 0.85rem; opacity: 0.75; }
  .reward {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.55rem;
    line-height: 1.15;
    color: color-mix(in srgb, var(--k) 70%, var(--coupon-ink));
  }
  h3 { margin: 10px 0 0; font-family: var(--font-text); font-size: 1rem; font-weight: 600; }
  h3 a { color: inherit; text-decoration: none; }
  /* tutto il buono è cliccabile */
  h3 a::after { content: ''; position: absolute; inset: 0; z-index: 2; }
  h3 a:focus-visible { outline: none; }
  .coupon:has(h3 a:focus-visible) { outline: 3px solid var(--accent); outline-offset: 3px; }
  .coupon:hover h3 a { text-decoration: underline; }
  .conditions, .where, .works { margin: 6px 0 0; font-size: 0.9rem; line-height: 1.45; }
  .where { font-family: var(--font-hand); font-size: 1.1rem; }
  .works { opacity: 0.75; }

  /* timbro a inchiostro: blu, rosso negli ultimi giorni, grigio a promozione conclusa */
  .stamp {
    flex: none;
    padding: 3px 8px;
    white-space: nowrap;
    font-family: var(--font-display);
    font-size: 0.82rem;
    line-height: 1.1;
    text-align: center;
    color: var(--stamp);
    border: 2.5px solid currentColor;
    border-radius: 6px;
    box-shadow: inset 0 0 0 1.5px var(--coupon-paper), inset 0 0 0 3px currentColor;
    rotate: 8deg;
    --o: 0.85;
    opacity: var(--o);
  }
  .is-ending .stamp { --o: 1; color: var(--stamp-hot); }
  .is-over { opacity: 0.7; }
  .is-over .stamp { --o: 1; color: var(--muted); }

  @keyframes tear-in {
    from { opacity: 0; transform: translateY(-26px) rotate(-5deg); }
    60% { opacity: 1; transform: translateY(3px) rotate(1deg); }
    to { opacity: 1; transform: none; }
  }
  @keyframes stamp-in {
    from { opacity: 0; scale: 1.8; }
    70% { opacity: 1; scale: 0.94; }
    to { opacity: var(--o); scale: 1; }
  }
  @keyframes stamp-pulse { 50% { scale: 1.12; } }
  @keyframes snip { to { left: calc(100% - 40px); } }

  /* ingresso: i buoni si staccano dal blocchetto uno dopo l'altro, poi arriva il timbro */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .coupon[data-reveal] { opacity: 0; transform-origin: 20% 0; }
    :global(.js) .coupon[data-reveal].is-in { animation: tear-in 0.75s var(--ease-spring) forwards; animation-delay: calc(var(--i) * 90ms); }
    :global(.js) .coupon[data-reveal] .stamp { opacity: 0; }
    :global(.js) .coupon[data-reveal].is-in .stamp {
      animation: stamp-in 0.4s var(--ease-out) forwards;
      animation-delay: calc(var(--i) * 90ms + 550ms);
    }
    :global(.js) .coupon.is-ending[data-reveal].is-in .stamp {
      animation: stamp-in 0.4s var(--ease-out) forwards, stamp-pulse 0.5s var(--ease-in-out) 2;
      animation-delay: calc(var(--i) * 90ms + 550ms), calc(var(--i) * 90ms + 1000ms);
    }
    :global(.js) .coupon.is-over[data-reveal].is-in .stamp { opacity: 1; animation: none; }
    /* nella pagina della promozione le forbicine ritagliano il buono, una volta */
    :global(.js) .coupon:not(.linked).is-in .scissors { animation: snip 1.3s var(--ease-in-out) 0.9s forwards; }
  }
  @media (prefers-reduced-motion: reduce) {
    .scissors { transition: none; }
  }
</style>
