---
// Home: il cassetto con le uscite dei prossimi giorni. Una cartellina per libro, nel colore del genere,
// con la copertina che spunta e la data scritta a penna sulla linguetta.
import CoverArt from './CoverArt.astro';
import { themeForWork } from '../lib/book-themes';
import { FORMAT_LABELS } from '../lib/format';
import type { Edition, Work } from '../lib/types';

interface Props {
  editions: Array<Edition & { work: Work }>;
}

const { editions } = Astro.props;
const today = new Date().toISOString().slice(0, 10);
const in14 = new Date(Date.now() + 14 * 86400000).toISOString().slice(0, 10);

// un'uscita per libro: la prima data futura, con tutti i formati di quel giorno
type Item = { work: Work; date: string; formats: string[]; special: Edition['edition_type'] | null };
const byWork = new Map<string, Item>();
for (const e of editions.filter((e) => e.release_date && e.release_date >= today).sort((a, b) => a.release_date!.localeCompare(b.release_date!))) {
  const item = byWork.get(e.work.slug);
  if (!item) {
    byWork.set(e.work.slug, {
      work: e.work,
      date: e.release_date!,
      formats: [FORMAT_LABELS[e.format]],
      special: e.edition_type !== 'standard' ? e.edition_type : null,
    });
  } else if (item.date === e.release_date) {
    item.formats.push(FORMAT_LABELS[e.format]);
    if (e.edition_type !== 'standard') item.special = e.edition_type;
  }
}
const all = [...byWork.values()];
// le prossime due settimane; se sono poche, le prossime sei uscite
const soon = all.filter((i) => i.date <= in14);
const isSoon = soon.length >= 4;
const items = isSoon ? soon : all.slice(0, 6);

const day = (iso: string) => new Date(iso).toLocaleDateString('it-IT', { day: 'numeric', month: 'short' });
const heading = isSoon ? 'In uscita nelle prossime due settimane' : 'Le prossime uscite';
const period = isSoon ? `dal ${day(today)} al ${day(in14)}` : '';
---

{items.length > 0 && (
  <section class="week" aria-labelledby="week-title">
    <div class="note">
      <h1 id="week-title">{heading}</h1>
      {period && <p>{period}</p>}
    </div>
    <div class="drawer">
      <ol class="row">
        {items.map((item, i) => {
          const theme = themeForWork(item.work);
          return (
            <li class="wk" style={`--d:${i};--f:${theme.light};--f2:${theme.dark};--ink:${theme.ink}`}>
              <a href={`/libri/${item.work.slug}`}>
                <span class="cover"><CoverArt work={item.work} class="wk-cover" transitionName={`cover-${item.work.slug}`} /></span>
                <span class="front">
                  <span class="tab"><span class="label">{day(item.date)}</span></span>
                  <strong class="title">{item.work.title}</strong>
                  <span class="meta">{item.work.authors.map((a) => a.name).join(', ')}</span>
                  <span class="meta">{[...new Set(item.formats)].join(', ')}</span>
                  {item.special && <span class="flag">{item.special === 'limited' ? 'Edizione limitata' : 'Edizione speciale'}</span>}
                </span>
              </a>
            </li>
          );
        })}
      </ol>
    </div>
  </section>
)}

<style>
  .week { margin: 8px 0 12px; }
  .note { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 16px; margin: 0 0 14px 6px; transform: rotate(-1.2deg); transform-origin: left; }
  .note h1 { margin: 0; font-family: var(--font-hand); font-size: var(--step-3); color: var(--accent); line-height: 1.1; }
  .note p { margin: 0; font-family: var(--font-hand); font-size: var(--step-1); color: var(--muted); }

  .drawer {
    position: relative;
    padding: 34px 18px 0;
    background: var(--drawer-bg) var(--grain);
    border-radius: 16px 16px 0 0;
    box-shadow: inset 0 10px 16px -10px rgba(0, 0, 0, 0.3), 0 14px 18px -14px rgba(0, 0, 0, 0.35);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
  }
  .row { display: flex; gap: 14px; margin: 0; padding: 0; list-style: none; }
  .wk { flex: 1 0 186px; max-width: 230px; scroll-snap-align: start; }
  .wk a { position: relative; display: block; height: 318px; color: var(--ink); text-decoration: none; }

  /* la copertina sta dentro la cartellina e ne spunta fuori */
  .cover { position: absolute; top: 0; left: calc(50% - 62px); width: 124px; transition: transform 0.4s var(--ease-spring); }
  .cover :global(.wk-cover) { display: block; width: 100%; height: auto; filter: drop-shadow(2px 4px 6px rgba(0, 0, 0, 0.3)); }
  .wk a:hover .cover,
  .wk a:focus-visible .cover { transform: translateY(-14px) rotate(-2deg); }

  .front {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 168px;
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 28px 14px 14px;
    background: linear-gradient(var(--f), var(--f2)) ;
    border-radius: 4px 4px 0 0;
    box-shadow: 0 -4px 10px rgba(0, 0, 0, 0.18), inset 0 1px 0 rgba(255, 255, 255, 0.4);
  }
  .front::after { content: ''; position: absolute; inset: 0; background: var(--grain); border-radius: inherit; pointer-events: none; }
  .tab {
    position: absolute;
    top: -24px;
    left: 14px;
    height: 26px;
    padding: 4px 14px 0;
    background: var(--f);
    clip-path: polygon(8px 0, calc(100% - 8px) 0, 100% 100%, 0 100%);
  }
  .label {
    display: inline-block;
    padding: 0 8px;
    background: var(--label-paper) var(--grain);
    border: 1px solid rgba(0, 0, 0, 0.18);
    border-radius: 2px;
    font-family: var(--font-hand);
    font-size: 1.05rem;
    line-height: 1.25;
    color: var(--folder-ink);
  }
  .title { font-family: var(--font-display); font-weight: 400; font-size: 1.08rem; line-height: 1.2; }
  .meta { font-size: 0.8rem; opacity: 0.8; line-height: 1.3; }
  .flag { margin-top: auto; align-self: flex-start; font-family: var(--font-hand); font-size: 1.05rem; color: var(--limited); transform: rotate(-3deg); }

  /* apertura: il cassetto avanza, le cartelline salgono una dopo l'altra, le copertine spuntano */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .note { animation: ink-in 0.6s var(--ease-out) backwards 0.1s; }
    :global(.js) .drawer { animation: rise 0.6s var(--ease-out) backwards; }
    :global(.js) .wk { animation: rise 0.65s var(--ease-spring) backwards; animation-delay: calc(var(--d) * 90ms + 280ms); }
    :global(.js) .cover { animation: peek 0.6s var(--ease-spring) backwards; animation-delay: calc(var(--d) * 90ms + 560ms); }
  }
  @keyframes peek { from { opacity: 0; transform: translateY(70px); } to { opacity: 1; transform: none; } }

  @media (max-width: 700px) {
    .drawer { margin: 0 -16px; border-radius: 0; padding: 30px 16px 0; }
    .wk { flex-basis: 168px; }
  }
</style>
