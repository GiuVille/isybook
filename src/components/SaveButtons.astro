---
// Pulsanti "Preferito" (o "Da vedere") e "Aggiungi a cartella" per un libro o per una serie/film.
// Lo stato vive nel browser (src/lib/library.ts): i libri vanno nel cassetto, serie e film nella videoteca.
import type { ItemKind } from '../lib/library';

interface Props {
  slug: string;
  title: string;
  kind?: ItemKind;
  compact?: boolean; // solo icone (anteprime)
}

const { slug, title, kind = 'book', compact = false } = Astro.props;
const screen = kind === 'screen';
---

<div class:list={['save', { compact, screen }]} data-slug={slug} data-kind={kind}>
  <button
    type="button"
    class="fav"
    aria-pressed="false"
    title={screen ? `Aggiungi «${title}» ai titoli da vedere` : `Aggiungi «${title}» ai preferiti`}
  >
    {screen ? (
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M3.5 10h17v9a1.5 1.5 0 0 1-1.5 1.5H5A1.5 1.5 0 0 1 3.5 19Z" />
        <path d="M3.2 9.6 2.6 6.9a1.4 1.4 0 0 1 1-1.7l13.6-3.1a1.4 1.4 0 0 1 1.7 1l.6 2.7Z" />
        <path class="stripes" d="m7 4.8 2.6 3.4M11.6 3.8l2.6 3.4M16 2.8l2.6 3.4" />
      </svg>
    ) : (
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 20.5s-7.5-4.6-9.3-9.2C1.4 7.9 3.6 4.5 7 4.5c2 0 3.6 1.1 5 3 1.4-1.9 3-3 5-3 3.4 0 5.6 3.4 4.3 6.8-1.8 4.6-9.3 9.2-9.3 9.2Z" />
      </svg>
    )}
    <span class="text">{screen ? 'Da vedere' : 'Preferito'}</span>
  </button>

  <div class="pick">
    <button type="button" class="add" aria-expanded="false" aria-haspopup="true" title={`Salva «${title}» in una cartella`}>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M3 6.5A1.5 1.5 0 0 1 4.5 5h4.6l2 2.2h8.4A1.5 1.5 0 0 1 21 8.7v9.8a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 18.5Z" />
        <path class="plus" d="M12 10.5v6M9 13.5h6" />
      </svg>
      <span class="text">Cartella</span>
      <span class="in-count" hidden></span>
    </button>
    <div class="pop" hidden>
      <p class="pop-title">{screen ? 'Salva in una cartella della videoteca' : 'Salva in una cartella'}</p>
      <ul class="cols"></ul>
      <form class="new">
        <input type="text" maxlength="40" placeholder="Nuova cartella…" aria-label="Nome della nuova cartella" />
        <button type="submit">Crea</button>
      </form>
    </div>
  </div>
</div>

<script>
  import {
    collectionsOf,
    createCollection,
    favoritesOf,
    getLibrary,
    onLibraryChange,
    toggleFavorite,
    toggleInCollection,
    type ItemKind,
    type Library,
  } from '../lib/library';
  import { esc } from '../lib/book-card';
  import { flyToLibrary, heartBurst } from '../scripts/celebrate';

  const blocks = [...document.querySelectorAll<HTMLElement>('.save[data-slug]')];
  const kindOf = (block: HTMLElement) => (block.dataset.kind ?? 'book') as ItemKind;
  // colore della festa: rosa per i libri, rosso sipario per serie e film
  const colorOf = (kind: ItemKind) => (kind === 'screen' ? '#c62828' : '#c2185b');

  function render(library: Library) {
    for (const block of blocks) {
      const slug = block.dataset.slug!;
      const kind = kindOf(block);
      const collections = collectionsOf(library, kind);
      const fav = favoritesOf(library, kind).includes(slug);
      const favButton = block.querySelector<HTMLButtonElement>('.fav')!;
      favButton.setAttribute('aria-pressed', String(fav));
      block.querySelector('.fav .text')!.textContent =
        kind === 'screen' ? (fav ? 'Da vedere ✓' : 'Da vedere') : fav ? 'Nei preferiti' : 'Preferito';

      const inCollections = collections.filter((c) => c.slugs.includes(slug));
      const count = block.querySelector<HTMLElement>('.in-count')!;
      count.hidden = inCollections.length === 0;
      count.textContent = String(inCollections.length);
      block.querySelector('.add')!.classList.toggle('active', inCollections.length > 0);

      block.querySelector('.cols')!.innerHTML = collections.length
        ? collections
            .map(
              (c) => `<li><label><input type="checkbox" value="${esc(c.id)}" ${c.slugs.includes(slug) ? 'checked' : ''}>
                <span>${esc(c.name)}</span><small>${c.slugs.length}</small></label></li>`,
            )
            .join('')
        : `<li class="none">Nessuna cartella${kind === 'screen' ? ' nella videoteca' : ''}: creane una qui sotto.</li>`;
    }
  }

  function closeAll(except?: HTMLElement) {
    for (const block of blocks) {
      if (block === except) continue;
      block.querySelector<HTMLElement>('.pop')!.hidden = true;
      block.querySelector('.add')!.setAttribute('aria-expanded', 'false');
    }
  }

  for (const block of blocks) {
    const slug = block.dataset.slug!;
    const kind = kindOf(block);
    const shape = kind === 'screen' ? 'tape' : 'book';
    const pop = block.querySelector<HTMLElement>('.pop')!;
    const add = block.querySelector<HTMLButtonElement>('.add')!;

    const favButton = block.querySelector<HTMLButtonElement>('.fav')!;
    favButton.addEventListener('click', () => {
      const library = toggleFavorite(slug, kind);
      // festeggia solo quando si aggiunge, non quando si toglie
      if (favoritesOf(library, kind).includes(slug)) {
        heartBurst(favButton, kind === 'screen' ? '★' : '♥', colorOf(kind));
        flyToLibrary(favButton, colorOf(kind), shape);
      }
    });

    add.addEventListener('click', (e) => {
      e.stopPropagation();
      closeAll(block);
      pop.hidden = !pop.hidden;
      add.setAttribute('aria-expanded', String(!pop.hidden));
      if (!pop.hidden) pop.querySelector('input')?.focus();
    });

    pop.addEventListener('click', (e) => e.stopPropagation());
    pop.addEventListener('change', (e) => {
      const input = e.target as HTMLInputElement;
      if (input.type !== 'checkbox') return;
      toggleInCollection(input.value, slug, kind);
      if (input.checked) flyToLibrary(add, undefined, shape);
    });

    pop.querySelector('form')!.addEventListener('submit', (e) => {
      e.preventDefault();
      const input = pop.querySelector<HTMLInputElement>('.new input')!;
      if (!input.value.trim()) return;
      const collection = createCollection(input.value, kind);
      toggleInCollection(collection.id, slug, kind);
      flyToLibrary(add, undefined, shape);
      input.value = '';
    });
  }

  document.addEventListener('click', () => closeAll());
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeAll();
  });

  render(getLibrary());
  onLibraryChange(render);
</script>

<style>
  .save { display: inline-flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  button {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    font: inherit;
    font-size: 0.9rem;
    color: inherit;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 999px;
    cursor: pointer;
  }
  button:hover { border-color: var(--accent); }
  svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linejoin: round; stroke-linecap: round; }
  .fav[aria-pressed='true'] { color: #c2185b; border-color: #c2185b; }
  .fav[aria-pressed='true'] svg { fill: #c2185b; }
  .screen .fav[aria-pressed='true'] { color: #c62828; border-color: #c62828; }
  .screen .fav[aria-pressed='true'] svg { fill: #c62828; }
  .screen .fav[aria-pressed='true'] svg .stripes { stroke: #fff; }
  .add.active { color: var(--accent); border-color: var(--accent); }
  .in-count {
    min-width: 1.4em;
    padding: 0 5px;
    font-size: 0.75rem;
    text-align: center;
    color: var(--surface);
    background: var(--accent);
    border-radius: 999px;
  }
  .in-count[hidden] { display: none; }

  /* versione compatta per le anteprime: solo icone, sopra i colori del genere */
  .compact button { padding: 6px; background: rgba(255, 255, 255, 0.75); border-color: transparent; color: #2a2230; }
  .compact .text { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }

  .pick { position: relative; }
  .pop {
    position: absolute;
    z-index: 20;
    top: calc(100% + 6px);
    right: 0;
    width: 250px;
    padding: 10px;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.18);
    font-family: var(--font-text);
    text-align: left;
  }
  .pop[hidden] { display: none; }
  .pop-title { margin: 0 0 6px; font-size: 0.8rem; color: var(--muted); }
  .cols { list-style: none; margin: 0 0 8px; padding: 0; max-height: 200px; overflow-y: auto; }
  .cols :global(label) { display: flex; align-items: center; gap: 8px; padding: 5px 4px; border-radius: 6px; cursor: pointer; font-size: 0.92rem; }
  .cols :global(label:hover) { background: var(--accent-soft); }
  .cols :global(label span) { flex: 1; }
  .cols :global(small) { color: var(--muted); }
  .cols :global(.none) { font-size: 0.85rem; color: var(--muted); padding: 4px; }
  .new { display: flex; gap: 6px; }
  .new input {
    flex: 1;
    min-width: 0;
    padding: 6px 10px;
    font: inherit;
    font-size: 0.9rem;
    color: inherit;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 8px;
  }
  .new button { padding: 6px 12px; color: var(--surface); background: var(--accent); border-color: var(--accent); }
</style>
