# Copia in .env e compila. Senza Supabase il sito usa i dati di esempio.

# --- Supabase (Project Settings → API) ---
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
# Solo per gli script lato server (import). Mai nel frontend, mai su git.
SUPABASE_SERVICE_ROLE_KEY=

# --- Modulo AI (qualsiasi API compatibile OpenAI) ---
# Mistral:  AI_BASE_URL=https://api.mistral.ai/v1        AI_MODEL=mistral-small-latest
# Groq:     AI_BASE_URL=https://api.groq.com/openai/v1   AI_MODEL=llama-3.3-70b-versatile
# Ollama:   AI_BASE_URL=http://localhost:11434/v1        AI_MODEL=llama3.1   (AI_API_KEY vuota)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# --- Google Books (opzionale, alza i limiti di richieste) ---
GOOGLE_BOOKS_API_KEY=

# --- Cloudflare Pages (Settings → Builds & deployments → Deploy hooks) ---
# Indirizzo che fa ripartire la build del sito. Va tenuto segreto: chi lo conosce può avviare build.
CLOUDFLARE_DEPLOY_HOOK=
